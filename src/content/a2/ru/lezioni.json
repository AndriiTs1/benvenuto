      ],
      [
       "tu",
       "-i",
       "-i",
       "-i"
      ],
      [
       "lui / lei",
       "-a",
       "-e",
       "-e"
      ],
      [
       "noi",
       "-iamo",
       "-iamo",
       "-iamo"
      ],
      [
       "voi",
