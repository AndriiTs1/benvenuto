      [
       "lui / lei",
       "fin|isce",
       "prefer|isce"
      ],
      [
       "noi",
       "fin|iamo",
       "prefer|iamo"
      ],
      [
       "voi",
       "fin|ite",
       "prefer|ite"
      ],
      [
       "loro",
       "fin|iscono",
       "prefer|iscono"
      ]
     ],
     "note": "-isc- появляется только в io, tu, lui/lei и loro. Так же спрягаются: {{capire}}, {{pulire}}, {{costruire}}, {{preferire}}."
    }
   ],
   "uses": [
    {
     "text": "Действие сейчас",
     "it": "Adesso mangio.",
     "tr": "Сейчас я ем."
    },
    {
     "text": "Привычка, то, что повторяется",
     "it": "Ogni giorno prendo l'autobus.",
     "tr": "Каждый день я езжу на автобусе."
    },
    {
     "text": "Общеизвестный факт",
     "it": "L'acqua bolle a 100 gradi.",
     "tr": "Вода кипит при 100 градусах."
    },
    {
     "text": "Ближайшее будущее, план",
     "it": "Domani parto per Roma.",
     "tr": "Завтра я уезжаю в Рим."
    },
    {
     "text": "Как давно — с {{da}}",
     "it": "Abito qui da cinque anni.",
     "tr": "Я живу здесь пять лет."
    }
   ],
   "exceptions": [
    {
     "title": "Глаголы на -care и -gare",
     "text": "Перед окончанием на {{-i}} добавляется {{h}}, чтобы звук остался твёрдым [к], [г].",
     "examples": [
      {
       "it": "cercare → tu cerchi, noi cerchiamo",
       "tr": "искать → ты ищешь, мы ищем"
      },
      {
       "it": "pagare → tu paghi, noi paghiamo",
       "tr": "платить → ты платишь, мы платим"
      }
     ]
    },
    {
     "title": "Глаголы на -iare",
     "text": "Пишется только **одна** {{i}}.",
     "examples": [
      {
       "it": "mangiare → tu mangi, noi mangiamo",
       "tr": "есть → ты ешь, мы едим"
      },
      {
       "it": "studiare → tu studi",
       "tr": "учиться → ты учишься"
      }
     ]
    },
    {
     "title": "Глаголы на -cere и -gere",
     "text": "Пишутся по правилу, но **звук меняется**: перед {{-o}} твёрдый, перед {{-i}}, {{-e}} мягкий.",
     "examples": [
      {
       "it": "leggo [г] — leggi [дж]",
       "tr": "я читаю — ты читаешь"
      },
      {
       "it": "vinco [к] — vinci [ч]",
       "tr": "я выигрываю — ты выигрываешь"
      }
     ]
    },
    {
     "title": "Ударение в loro",
     "text": "Ударение остаётся на основе, а не на окончании.",
     "examples": [
      {
       "it": "pàrlano, prèndono, dòrmono",
       "tr": "не «parlàno»"
      }
     ]
    }
   ],
   "mistakes": [
    {
     "wrong": "Tu mangii.",
     "right": "Tu mangi.",
     "why": "У глаголов на -iare пишется одна i."
    },
    {
     "wrong": "Tu cerci.",
     "right": "Tu cerchi.",
     "why": "h сохраняет звук [к]."
    },
    {
     "wrong": "Noi finisciamo.",
     "right": "Noi finiamo.",
     "why": "В noi и voi -isc- нет."
    },
