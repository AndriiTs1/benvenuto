       "si sono alzati / alzate"
      ]
     ],
     "note": "Причастие согласуется с подлежащим: {{-o / -a / -i / -e}}."
    },
    {
     "title": "С модальными глаголами — два варианта",
     "header": true,
     "rows": [
      [
       "",
       "presente",
       "con dovere / potere / volere"
      ],
      [
       "io",
       "mi alzo",
       "mi devo alzare = devo alzarmi"
      ],
      [
       "tu",
       "ti alzi",
       "ti devi alzare = devi alzarti"
      ],
      [
       "lui / lei",
       "si alza",
       "si deve alzare = deve alzarsi"
      ],
      [
       "noi",
       "ci alziamo",
       "ci dobbiamo alzare = dobbiamo alzarci"
      ],
      [
       "voi",
       "vi alzate",
       "vi dovete alzare = dovete alzarvi"
      ],
      [
       "loro",
       "si alzano",
       "si devono alzare = devono alzarsi"
      ]
     ],
     "note": "Местоимение ставится перед модальным глаголом или присоединяется к концу инфинитива — оба варианта правильные."
    }
   ],
   "uses": [
    {
     "text": "Действие на себя",
     "it": "Mi lavo e mi vesto.",
     "tr": "Я моюсь и одеваюсь."
    },
    {
     "text": "Распорядок дня",
     "it": "La mattina mi sveglio alle sette.",
     "tr": "Утром я просыпаюсь в семь."
